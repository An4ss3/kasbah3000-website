---
import { getCollection } from 'astro:content';
import CtaBand from '@components/content/CtaBand.astro';
import PageHero from '@components/content/PageHero.astro';
import PrincipleCard from '@components/content/PrincipleCard.astro';
import SectionTitle from '@components/content/SectionTitle.astro';
import BaseLayout from '@components/layout/BaseLayout.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import Seo from '@components/seo/Seo.astro';
import { SITE } from '@constants';
import { t } from '@lib/utils/i18n';

export const prerender = true;

const lang = 'fr' as const;
const principles = await getCollection('principles', ({ data }) => data.lang === lang);
principles.sort((a, b) => a.data.order - b.data.order);
const canonical = '/principles';
const structuredData = {
  name: t(lang, 'principles.hero.title'),
  description: t(lang, 'principles.hero.description'),
  url: new URL(canonical, SITE.url).href,
  inLanguage: lang,
};
---

<BaseLayout
  lang={lang}
  title={t(lang, 'principles.hero.title')}
  description={t(lang, 'principles.hero.description')}
>
  <Seo
    slot="head"
    title={t(lang, 'principles.hero.title')}
    description={t(lang, 'principles.hero.description')}
    lang={lang}
    canonical={canonical}
  />
  <JsonLd slot="head" type="WebSite" data={structuredData} />

  <PageHero
    title={t(lang, 'principles.hero.title')}
    description={t(lang, 'principles.hero.description')}
    imageSrc="/brand/logo.jpeg"
    imageAlt=""
  />

  <section class="border-b border-border py-14 md:py-20 lg:py-30">
    <div class="mx-auto max-w-content px-5 md:px-8 lg:px-12">
      <div class="grid gap-8 lg:grid-cols-[1fr_1.25fr] lg:gap-20">
        <SectionTitle
          eyebrow={t(lang, 'principles.intro.eyebrow')}
          title={t(lang, 'principles.intro.title')}
        />
        <p class="max-w-prose text-base leading-7 text-text-body md:text-lg">
          {t(lang, 'principles.intro.body')}
        </p>
      </div>

      <div class="mt-16 grid gap-12 md:grid-cols-2 lg:grid-cols-3 lg:gap-14">
        {principles.map(({ data }) => <PrincipleCard principle={data} lang={lang} />)}
      </div>
    </div>
  </section>

  <CtaBand title={t(lang, 'principles.cta.title')} variant="dark" />
</BaseLayout>
