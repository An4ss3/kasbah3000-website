---
import BaseLayout from '@components/layout/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import { SITE } from '@constants';
import { getLanguageFromPath, t } from '@lib/utils/i18n';
import '@styles/typography.css';

export const prerender = false;

const lang = getLanguageFromPath(Astro.url.pathname);
const title = t(lang, 'notFound.title');
const description = t(lang, 'notFound.description');
const homeHref = lang === SITE.defaultLanguage ? '/' : `/${lang}/`;
const contactHref = lang === SITE.defaultLanguage ? '/contact' : `/${lang}/contact`;

// Guarantee a hard 404 rather than a soft 404: the requested URL does not exist, so it
// must never be served with a 200 status.
Astro.response.status = 404;
---

<BaseLayout lang={lang} title={title} description={description}>
  {
    /*
    An error page deliberately omits canonical, hreflang and Open Graph tags: the
    requested URL has no valid equivalent in any locale, so advertising alternates
    would point crawlers at further 404s. `follow` keeps the on-page links crawlable.
  */
  }
  <Fragment slot="seo">
    <title>{`${title} — ${SITE.name}`}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
  </Fragment>

  <section
    class="flex min-h-[60vh] flex-col items-center justify-center px-5 py-14 text-center md:px-8 md:py-20 lg:py-30"
    aria-labelledby="not-found-heading"
  >
    <p class="type-eyebrow text-muted">{t(lang, 'notFound.eyebrow')}</p>
    <h1 id="not-found-heading" class="type-h2 mt-5 text-balance text-ink">
      {t(lang, 'notFound.heading')}
    </h1>
    <p class="mt-6 max-w-prose text-base leading-7 text-text-body">{description}</p>
    <div class="mt-10 flex flex-col gap-4 sm:flex-row">
      <Button variant="primary-dark" href={homeHref}>{t(lang, 'notFound.homeLink')}</Button>
      <Button variant="outline" href={contactHref}>{t(lang, 'notFound.contactLink')}</Button>
    </div>
  </section>
</BaseLayout>
