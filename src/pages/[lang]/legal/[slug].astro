---
import LegalPage from '@components/pages/LegalPage.astro';
import { SITE } from '@constants';
import { getLegalEntries, type LegalEntry } from '@lib/content/legal';
import { isLanguage } from '@lib/utils/i18n';
import { render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const languages = SITE.languages.filter((language) => language !== SITE.defaultLanguage);

  const paths = await Promise.all(
    languages.map(async (language) => {
      const entries = await getLegalEntries(language);

      return entries.map((entry) => ({
        params: { lang: language, slug: entry.data.slug },
        props: { entry },
      }));
    })
  );

  return paths.flat();
}

const { lang: langParam } = Astro.params;
if (!isLanguage(langParam)) throw new Error(`Unsupported language: ${langParam ?? 'undefined'}`);
const lang = langParam;

const { entry } = Astro.props as { entry: LegalEntry };
const { Content } = await render(entry);
---

<LegalPage
  lang={lang}
  title={entry.data.title}
  slug={entry.data.slug}
  lastUpdated={entry.data.lastUpdated}
>
  <Content />
</LegalPage>
