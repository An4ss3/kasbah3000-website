---
import BlogPage from '@components/pages/BlogPage.astro';
import { SITE } from '@constants';
import { getArticles } from '@lib/content/articles';
import { getArticleCategories } from '@lib/utils/blog-categories';
import { isLanguage } from '@lib/utils/i18n';

export const prerender = true;

interface Props {
  category: string;
}

export async function getStaticPaths() {
  const languages = SITE.languages.filter((language) => language !== SITE.defaultLanguage);
  const categories = await getArticleCategories();

  return languages.flatMap((language) =>
    categories.map((category) => ({
      params: { lang: language, slug: category },
      props: { category },
    }))
  );
}

const { lang: langParam } = Astro.params;

if (!isLanguage(langParam)) {
  throw new Error(`Unsupported language: ${langParam ?? 'undefined'}`);
}

const lang = langParam;
const { category } = Astro.props;
const allArticles = await getArticles();
const articles = allArticles.filter((article) => article.category === category);
const categories = await getArticleCategories();
---

<BlogPage lang={lang} articles={articles} categories={categories} activeCategory={category} />
