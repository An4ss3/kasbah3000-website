---
import ArticleCard from '@components/content/ArticleCard.astro';
import CtaBand from '@components/content/CtaBand.astro';
import Hero from '@components/content/Hero.astro';
import HeroVideo from '@components/content/HeroVideo.astro';
import KeyFigures from '@components/content/KeyFigures.astro';
import SectionTitle from '@components/content/SectionTitle.astro';
import NewsletterForm from '@components/islands/NewsletterForm';
import ProjectMap from '@components/islands/ProjectMap';
import BaseLayout from '@components/layout/BaseLayout.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import Seo from '@components/seo/Seo.astro';
import Button from '@components/ui/Button.astro';
import { STRUCTURED_DATA } from '@constants';
import { getArticles } from '@lib/content/articles';
import { getPrinciples } from '@lib/content/principles';
import { getNewsletterFormCopy } from '@lib/forms/copy';
import { getLocalizedPath, t } from '@lib/utils/i18n';
import type { Language } from '@types';
import '@styles/typography.css';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const principles = (await getPrinciples(lang)).slice(0, 6);
const technologyPrinciples = principles.slice(0, 4);
const articles = (await getArticles(lang)).slice(0, 3);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ?? '';

const projectPath = getLocalizedPath('/project', lang);
const contactPath = getLocalizedPath('/contact', lang);
const principlesPath = getLocalizedPath('/principles', lang);
const blogPath = getLocalizedPath('/blog', lang);
const fundingPath = getLocalizedPath('/funding', lang);

const figures = [
  { value: t(lang, 'home.figures.one.value'), label: t(lang, 'home.figures.one.label') },
  { value: t(lang, 'home.figures.two.value'), label: t(lang, 'home.figures.two.label') },
  { value: t(lang, 'home.figures.three.value'), label: t(lang, 'home.figures.three.label') },
  { value: t(lang, 'home.figures.four.value'), label: t(lang, 'home.figures.four.label') },
];

const editorialSections = [
  {
    eyebrow: t(lang, 'home.vision.eyebrow'),
    title: t(lang, 'home.vision.title'),
    body: t(lang, 'home.vision.body'),
  },
  {
    eyebrow: t(lang, 'home.mission.eyebrow'),
    title: t(lang, 'home.mission.title'),
    body: t(lang, 'home.mission.body'),
  },
  {
    eyebrow: t(lang, 'home.values.eyebrow'),
    title: t(lang, 'home.values.title'),
    body: t(lang, 'home.values.body'),
  },
];

/*
  Line icons for the six lead principles on the homepage.

  The homepage stays icon-led on purpose: the photographic treatment is reserved for the
  Principles index and detail pages, where each image has room to carry meaning. Repeating the
  same renders here made the page compete with itself. `PrincipleCard` keeps the image-led
  composition and is used only by the Principles pages.

  Declared inline because the technical stack is frozen (PROJECT_RULES §7.1 admits no dependency
  additions) and the component inventory is capped at 44. 1.25 stroke on a 24 grid keeps them
  architectural rather than decorative. Unknown slugs fall back to a neutral mark.
*/
const PRINCIPLE_ICONS: Record<string, string> = {
  energy:
    '<circle cx="12" cy="12" r="3.75"/><path d="M12 2.5v2.1M12 19.4v2.1M4.7 4.7l1.5 1.5M17.8 17.8l1.5 1.5M2.5 12h2.1M19.4 12h2.1M4.7 19.3l1.5-1.5M17.8 6.2l1.5-1.5"/>',
  water:
    '<path d="M12 3.3c3.1 3.2 5.4 6 5.4 9.1a5.4 5.4 0 0 1-10.8 0c0-3.1 2.3-5.9 5.4-9.1Z"/><path d="M9.5 14.5a2.7 2.7 0 0 0 2.5 2.1"/>',
  food: '<path d="M4.6 20.4h14.8"/><path d="M12 20.4v-9.1"/><path d="M12 11.3C11 8.7 9 7.3 6 7.1c.2 3 1.6 5 4.2 5.8"/><path d="M12 11.3c1-2.6 3-4 6-4.2-.2 3-1.6 5-4.2 5.8"/><path d="M12 7.2c0-1.7.6-3 1.8-3.9"/>',
  architecture:
    '<path d="M3 20.6h18"/><path d="M5.2 20.6V10.4"/><path d="M18.8 20.6V10.4"/><path d="M4.6 10.4 12 4.6l7.4 5.8"/><path d="M9.6 20.6v-5.2a2.4 2.4 0 0 1 4.8 0v5.2"/>',
  mobility:
    '<circle cx="5.9" cy="16.8" r="3.3"/><circle cx="18.1" cy="16.8" r="3.3"/><path d="M9.2 16.8h5.6l-2.6-6.4H9.4"/><path d="m12.2 10.4 3-2.9h2.2"/>',
  governance:
    '<circle cx="9.2" cy="8" r="3.2"/><path d="M3.5 20.2a5.7 5.7 0 0 1 11.4 0"/><path d="M16.4 5.2a3.2 3.2 0 0 1 0 6.2"/><path d="M17.6 14.4a5.7 5.7 0 0 1 2.9 5.8"/>',
};
const PRINCIPLE_ICON_FALLBACK = '<path d="M12 3.8 20.2 12 12 20.2 3.8 12Z"/>';

const {
  '@context': _organizationContext,
  '@type': _organizationType,
  ...organizationData
} = STRUCTURED_DATA.organization;
const {
  '@context': _websiteContext,
  '@type': _websiteType,
  ...baseWebsiteData
} = STRUCTURED_DATA.website;
const websiteData = {
  ...baseWebsiteData,
  description: t(lang, 'home.description'),
  inLanguage: lang,
};
---

<BaseLayout lang={lang} title={t(lang, 'home.title')} description={t(lang, 'home.description')}>
  <Seo
    slot="seo"
    title={t(lang, 'home.title')}
    description={t(lang, 'home.description')}
    lang={lang}
    canonical={getLocalizedPath('/', lang)}
  />
  <Fragment slot="head">
    <JsonLd type="Organization" data={organizationData} />
    <JsonLd type="WebSite" data={websiteData} />
  </Fragment>

  <Hero
    eyebrow={t(lang, 'home.hero.eyebrow')}
    headline={t(lang, 'home.hero.headline')}
    headlineAccent={t(lang, 'home.hero.headlineAccent')}
    description={t(lang, 'home.hero.description')}
    primaryCta={{ label: t(lang, 'home.primaryCta'), href: projectPath }}
    secondaryCta={{ label: t(lang, 'home.secondaryCta'), href: contactPath }}
  >
    <HeroVideo
      slot="media"
      videoSrc="/media/video/kasbah3000-eco-village-solar.mp4"
      posterSrc="/media/home/hero-poster.jpg"
      posterSrcMobile="/media/home/hero-poster-mobile.jpg"
      alt={t(lang, 'home.hero.mediaAlt')}
    />
  </Hero>

  <aside class="border-b border-border bg-background-alt" aria-label={t(lang, 'home.notice.label')}>
    <div class="mx-auto max-w-content px-5 py-7 md:px-8 md:py-8 lg:px-12">
      <div class="flex flex-col gap-3 md:flex-row md:items-baseline md:gap-10">
        <div class="flex items-center gap-4 md:shrink-0">
          <span class="h-px w-10 shrink-0 bg-warning" aria-hidden="true"></span>
          <p class="type-eyebrow text-text-body">{t(lang, 'home.notice.eyebrow')}</p>
        </div>
        <p class="max-w-prose text-[0.9375rem] leading-7 text-text-body">
          {t(lang, 'home.notice.body')}
        </p>
      </div>
    </div>
  </aside>

  <section
    class="border-b border-border bg-background py-14 md:py-20 lg:py-30"
    aria-labelledby="approach-title"
  >
    <div
      class="mx-auto grid max-w-content gap-12 px-5 md:px-8 lg:grid-cols-[0.92fr_1.08fr] lg:items-start lg:gap-20 lg:px-12"
    >
      <figure class="lg:sticky lg:top-32">
        <div class="overflow-hidden rounded-t-[560px] bg-background-alt">
          <img
            src="/media/principles/governance.webp"
            alt={t(lang, 'home.approach.imageAlt')}
            width="1600"
            height="900"
            loading="lazy"
            decoding="async"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
        <figcaption class="mt-4 max-w-sm text-xs leading-6 text-text-body">
          {t(lang, 'home.approach.caption')}
        </figcaption>
      </figure>

      <div>
        <p class="type-eyebrow text-text-body">{t(lang, 'home.approach.eyebrow')}</p>
        <h2 id="approach-title" class="type-h2 mt-5 max-w-headline text-balance text-ink">
          {t(lang, 'home.approach.title')}
        </h2>
        <p class="mt-6 max-w-prose text-base leading-8 text-text-body md:text-[1.0625rem]">
          {t(lang, 'home.approach.body')}
        </p>

        <div class="mt-12 border-t border-border lg:mt-16">
          {
            editorialSections.map((section) => (
              <article class="grid gap-4 border-b border-border py-8 md:grid-cols-[8rem_1fr] md:gap-8">
                <p class="type-eyebrow pt-1 text-text-body">{section.eyebrow}</p>
                <div>
                  <h3 class="type-h4 text-balance text-ink">{section.title}</h3>
                  <p class="mt-3 text-sm leading-7 text-text-body">{section.body}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section
    class="border-b border-border-dark bg-background-dark py-14 md:py-20 lg:py-24"
    aria-labelledby="figures-title"
  >
    <div class="mx-auto max-w-content px-5 md:px-8 lg:px-12">
      <div class="max-w-2xl">
        <p class="type-eyebrow text-accent-on-dark">{t(lang, 'home.figures.eyebrow')}</p>
        <h2 id="figures-title" class="type-h2 mt-5 text-balance text-ink-inverse">
          {t(lang, 'home.figures.title')}
        </h2>
      </div>
      <KeyFigures
        figures={figures}
        class="mt-12 border-t border-border-dark pt-10 lg:mt-16"
        onDark
      />
    </div>
  </section>

  <section
    class="border-b border-border bg-background py-14 md:py-20 lg:py-30"
    aria-labelledby="principles-title"
  >
    <div class="mx-auto max-w-content px-5 md:px-8 lg:px-12">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <div id="principles-title">
          <SectionTitle
            eyebrow={t(lang, 'home.principles.eyebrow')}
            title={t(lang, 'home.principles.title')}
          />
        </div>
        <Button variant="outline" href={principlesPath}>{t(lang, 'home.principles.viewAll')}</Button
        >
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:mt-16 lg:grid-cols-3">
        {
          principles.map(({ data }) => (
            <a
              href={getLocalizedPath(`/principles/${data.slug}`, lang)}
              aria-label={data.title}
              class="group flex h-full flex-col border border-border bg-surface p-6 transition-colors duration-200 ease-out hover:bg-background-alt focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-clay-600"
            >
              <div class="flex items-center justify-between gap-4">
                <svg
                  class="h-7 w-7 shrink-0 text-clay-600"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.25"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                  set:html={PRINCIPLE_ICONS[data.slug] ?? PRINCIPLE_ICON_FALLBACK}
                />
                <p class="type-caption text-text-body">{String(data.order).padStart(2, '0')}</p>
              </div>
              <h3 class="type-h4 mt-6 text-balance text-ink transition-colors duration-200 ease-out group-hover:text-clay-600">
                {data.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-text-body">{data.excerpt}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="border-b border-border-dark bg-background-dark py-14 md:py-20 lg:py-30"
    aria-labelledby="technology-title"
  >
    <div class="mx-auto max-w-content px-5 md:px-8 lg:px-12">
      <div class="grid gap-8 lg:grid-cols-[1fr_1.25fr] lg:gap-20">
        <div>
          <p class="type-eyebrow text-accent-on-dark">{t(lang, 'home.technology.eyebrow')}</p>
          <h2 id="technology-title" class="type-h2 mt-5 text-balance text-ink-inverse">
            {t(lang, 'home.technology.title')}
          </h2>
        </div>
        <p class="max-w-prose text-base leading-8 text-text-body-dark">
          {t(lang, 'home.technology.body')}
        </p>
      </div>

      <div class="mt-12 grid gap-10 lg:mt-16 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
        <div class="overflow-hidden">
          <img
            src="/media/principles/water.webp"
            alt=""
            width="1600"
            height="900"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] h-full w-full object-cover"
          />
        </div>
        <ol class="border-t border-border-dark">
          {
            technologyPrinciples.map(({ data }) => (
              <li class="grid grid-cols-[3rem_1fr] gap-4 border-b border-border-dark py-6 md:grid-cols-[4rem_1fr] md:py-7">
                <span class="type-caption text-accent-on-dark">
                  {String(data.order).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="font-serif text-2xl font-medium text-ink-inverse">{data.title}</h3>
                  <p class="mt-2 text-sm leading-6 text-text-body-dark">{data.excerpt}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section
    class="border-b border-border bg-background-alt py-14 md:py-20 lg:py-30"
    aria-labelledby="home-map-title"
  >
    <div class="mx-auto max-w-content px-5 md:px-8 lg:px-12">
      <div class="grid gap-8 lg:grid-cols-[1fr_1.25fr] lg:items-end lg:gap-20">
        <div>
          <p class="type-eyebrow text-text-body">{t(lang, 'home.map.eyebrow')}</p>
          <h2 id="home-map-title" class="type-h2 mt-5 text-balance text-ink">
            {t(lang, 'home.map.title')}
          </h2>
        </div>
        <div>
          <p class="max-w-prose text-base leading-8 text-text-body">{t(lang, 'home.map.body')}</p>
          <Button variant="outline" href={projectPath} class="mt-7"
            >{t(lang, 'home.map.cta')}</Button
          >
        </div>
      </div>

      <div
        class="mt-12 h-[420px] overflow-hidden border border-border md:h-[520px] lg:mt-16 lg:h-[620px]"
      >
        <ProjectMap
          client:visible
          featuresUrl="/map/features.geojson"
          center={[-9.6, 30.4]}
          zoom={12}
          lang={lang}
          ariaLabel={t(lang, 'home.map.title')}
          fallbackText={t(lang, 'project.map.fallback')}
        />
      </div>
    </div>
  </section>

  <section
    class="border-b border-border bg-background py-14 md:py-20 lg:py-30"
    aria-labelledby="articles-title"
  >
    <div class="mx-auto max-w-content px-5 md:px-8 lg:px-12">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <div id="articles-title">
          <SectionTitle
            eyebrow={t(lang, 'home.articles.eyebrow')}
            title={t(lang, 'home.articles.title')}
          />
        </div>
        <Button variant="outline" href={blogPath}>{t(lang, 'home.articles.viewAll')}</Button>
      </div>
      <div class="mt-12 grid gap-12 md:grid-cols-2 lg:grid-cols-3 lg:gap-14">
        {articles.map((article) => <ArticleCard article={article} lang={lang} />)}
      </div>
    </div>
  </section>

  <section class="grid bg-background-dark lg:grid-cols-2" aria-labelledby="home-funding-title">
    <div class="min-h-[360px] overflow-hidden lg:min-h-[620px]">
      <img
        src="/media/site/village-aerial-overview.jpg"
        alt=""
        width="2048"
        height="1152"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover"
      />
    </div>
    <div class="flex items-center px-5 py-14 md:px-12 md:py-20 lg:px-20 lg:py-24">
      <div class="max-w-prose">
        <p class="type-eyebrow text-accent-on-dark">{t(lang, 'home.funding.eyebrow')}</p>
        <h2 id="home-funding-title" class="type-h2 mt-5 text-balance text-ink-inverse">
          {t(lang, 'home.funding.title')}
        </h2>
        <p class="mt-6 text-base leading-8 text-text-body-dark">{t(lang, 'home.funding.body')}</p>
        <Button variant="primary-light" href={fundingPath} class="mt-8">
          {t(lang, 'home.funding.cta')}
        </Button>
      </div>
    </div>
  </section>

  <section
    id="newsletter"
    class="border-t border-border-dark bg-background-dark py-14 text-ink-inverse md:py-20 lg:py-30"
    aria-labelledby="newsletter-title"
  >
    <div
      class="mx-auto grid max-w-content gap-10 px-5 md:px-8 lg:grid-cols-[1fr_1.5fr] lg:gap-20 lg:px-12"
    >
      <h2 id="newsletter-title" class="type-h2 max-w-headline text-balance text-ink-inverse">
        {t(lang, 'home.newsletter.title')}
      </h2>
      <div>
        <p class="max-w-prose text-base leading-8 text-text-body-dark">
          {t(lang, 'home.newsletter.description')}
        </p>
        <div class="mt-8">
          <NewsletterForm
            client:visible
            lang={lang}
            turnstileSiteKey={turnstileSiteKey}
            privacyHref={`${contactPath}#privacy-notice`}
            placement="home"
            copy={getNewsletterFormCopy(lang)}
          />
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow={t(lang, 'home.cta.eyebrow')}
    title={t(lang, 'home.cta.title')}
    primaryCta={{ label: t(lang, 'home.primaryCta'), href: projectPath }}
    secondaryCta={{ label: t(lang, 'home.secondaryCta'), href: contactPath }}
  />
</BaseLayout>
