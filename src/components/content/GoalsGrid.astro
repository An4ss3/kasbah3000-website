---
import '@styles/typography.css';

interface Goal {
  timeframe: '5y' | '20y';
  title: string;
  items: string[];
}

interface Props {
  goals: Goal[];
  class?: string;
}

const { goals, class: className } = Astro.props;
---

<div class:list={['grid overflow-hidden lg:grid-cols-2', className]}>
  {
    goals.map((goal, index) => (
      <article
        class:list={[
          'min-w-0 py-8 first:pt-0 last:pb-0 lg:px-12 lg:py-0 lg:first:ps-0 lg:last:pe-0',
          index > 0 && 'border-t border-sand-200 lg:border-s-1 lg:border-t-0',
        ]}
      >
        <p class="type-eyebrow text-muted">{goal.timeframe.toUpperCase()}</p>
        <h3 class="type-h3 mt-5 text-balance text-ink">{goal.title}</h3>
        <ul class="mt-7 space-y-4 ps-5 text-base leading-7 text-text-body marker:text-clay-500">
          {goal.items.map((item) => (
            <li class="ps-1">{item}</li>
          ))}
        </ul>
      </article>
    ))
  }
</div>
