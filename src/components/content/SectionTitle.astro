---
import '@styles/typography.css';

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  centered?: boolean;
  class?: string;
}

const { id, eyebrow, title, centered = false, class: className } = Astro.props;
---

<div class:list={['max-w-headline', centered && 'mx-auto text-center', className]}>
  {eyebrow && <p class="type-eyebrow mb-5 text-muted">{eyebrow}</p>}
  <h2 id={id} class="type-h2 text-balance text-ink">{title}</h2>
</div>
