---
import CtaBand from '@components/content/CtaBand.astro';
import FaqAccordion from '@components/content/FaqAccordion.astro';
import PageHero from '@components/content/PageHero.astro';
import PageLayout from '@components/layout/PageLayout.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import Seo from '@components/seo/Seo.astro';
import { SITE } from '@constants';
import { getFAQs } from '@lib/content/faqs';
import { getLocalizedPath, localize, t } from '@lib/utils/i18n';
import type { Language } from '@types';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const faqs = await getFAQs();
const faqPath = getLocalizedPath('/faq', lang);
const contactPath = getLocalizedPath('/contact', lang);
const breadcrumbData = {
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t(lang, 'navigation.home'),
      item: new URL(getLocalizedPath('/', lang), SITE.url).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t(lang, 'faq.hero.title'),
      item: new URL(faqPath, SITE.url).href,
    },
  ],
};
const faqData = {
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: localize(faq.question, lang),
    acceptedAnswer: {
      '@type': 'Answer',
      text: localize(faq.answer, lang),
    },
  })),
};
---

<PageLayout
  lang={lang}
  title={t(lang, 'faq.hero.title')}
  description={t(lang, 'faq.hero.description')}
>
  <Seo
    slot="seo"
    title={t(lang, 'faq.hero.title')}
    description={t(lang, 'faq.hero.description')}
    lang={lang}
    canonical={faqPath}
  />
  <JsonLd slot="head" type="BreadcrumbList" data={breadcrumbData} />
  <JsonLd slot="head" type="FAQPage" data={faqData} />

  <PageHero
    slot="hero"
    title={t(lang, 'faq.hero.title')}
    description={t(lang, 'faq.hero.description')}
  />

  <section aria-labelledby="faq-intro-title">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.5fr] lg:gap-20">
      <div>
        <p class="type-eyebrow text-muted">{t(lang, 'faq.intro.eyebrow')}</p>
        <h2 id="faq-intro-title" class="type-h2 mt-5 text-balance text-ink">
          {t(lang, 'faq.intro.title')}
        </h2>
      </div>
      <div>
        <p class="max-w-prose text-base leading-8 text-text-body">{t(lang, 'faq.intro.body')}</p>
        <div class="mt-10 lg:mt-12">
          <FaqAccordion faqs={faqs} lang={lang} label={t(lang, 'faq.accordion.label')} />
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    slot="full-width"
    class="border-t border-border-dark"
    eyebrow={t(lang, 'faq.cta.eyebrow')}
    title={t(lang, 'faq.cta.title')}
    primaryCta={{ label: t(lang, 'faq.cta.action'), href: contactPath }}
    variant="dark"
  />
</PageLayout>
