---
import CtaBand from '@components/content/CtaBand.astro';
import PageHero from '@components/content/PageHero.astro';
import Prose from '@components/content/Prose.astro';
import TeamGrid from '@components/content/TeamGrid.astro';
import PageLayout from '@components/layout/PageLayout.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import Seo from '@components/seo/Seo.astro';
import { SITE } from '@constants';
import { getTeamMembers } from '@lib/content/team';
import { getLocalizedPath, t } from '@lib/utils/i18n';
import type { Language } from '@types';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const teamPath = getLocalizedPath('/team', lang);
const contactPath = getLocalizedPath('/contact', lang);
const aboutPath = getLocalizedPath('/about', lang);

const members = await getTeamMembers();

const breadcrumbData = {
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t(lang, 'navigation.home'),
      item: new URL(getLocalizedPath('/', lang), SITE.url).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t(lang, 'team.hero.title'),
      item: new URL(teamPath, SITE.url).href,
    },
  ],
};
---

<PageLayout
  lang={lang}
  title={t(lang, 'team.hero.title')}
  description={t(lang, 'team.hero.description')}
>
  <Seo
    slot="seo"
    title={t(lang, 'team.hero.title')}
    description={t(lang, 'team.hero.description')}
    lang={lang}
    canonical={teamPath}
  />
  <JsonLd slot="head" type="BreadcrumbList" data={breadcrumbData} />

  <PageHero
    slot="hero"
    title={t(lang, 'team.hero.title')}
    description={t(lang, 'team.hero.description')}
    imageSrc="/images/placeholders/principles-header.svg"
    imageAlt={t(lang, 'team.hero.imageAlt')}
  />

  <section aria-labelledby="team-intro-title">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.5fr] lg:gap-20">
      <div>
        <p class="type-eyebrow mb-5 text-muted">{t(lang, 'team.intro.eyebrow')}</p>
        <h2 id="team-intro-title" class="type-h2 text-balance text-ink">
          {t(lang, 'team.intro.title')}
        </h2>
      </div>
      <Prose>
        <p>{t(lang, 'team.intro.body')}</p>
      </Prose>
    </div>
  </section>

  <Fragment slot="full-width">
    <section
      class="border-t border-border bg-background-alt py-14 md:py-20 lg:py-30"
      aria-labelledby="team-grid-title"
    >
      <div class="mx-auto max-w-content px-5 md:px-8 lg:px-12">
        <h2 id="team-grid-title" class="sr-only">{t(lang, 'team.grid.title')}</h2>
        <TeamGrid
          members={members}
          lang={lang}
          bioLabel={t(lang, 'team.card.bioLabel')}
          linkedinLabel={t(lang, 'team.card.linkedinLabel')}
          skillsLabel={t(lang, 'team.card.skillsLabel')}
        />
      </div>
    </section>

    <section
      class="border-t border-border bg-background py-14 md:py-20 lg:py-30"
      aria-labelledby="team-advisory-title"
    >
      <div class="mx-auto max-w-content px-5 text-center md:px-8 lg:px-12">
        <p class="type-eyebrow mb-5 text-muted">{t(lang, 'team.advisory.eyebrow')}</p>
        <h2 id="team-advisory-title" class="type-h2 mx-auto max-w-headline text-balance text-ink">
          {t(lang, 'team.advisory.title')}
        </h2>
        <p class="mx-auto mt-6 max-w-prose text-base leading-7 text-text-body">
          {t(lang, 'team.advisory.body')}
        </p>
      </div>
    </section>

    <CtaBand
      class="border-t border-border-dark"
      eyebrow={t(lang, 'team.cta.eyebrow')}
      title={t(lang, 'team.cta.title')}
      primaryCta={{ label: t(lang, 'team.cta.primary'), href: contactPath }}
      secondaryCta={{ label: t(lang, 'team.cta.secondary'), href: aboutPath }}
      variant="dark"
    />
  </Fragment>
</PageLayout>
