---
import { SITE } from '@constants';
import { getLocalizedPath } from '@lib/utils/i18n';
import '@styles/global.css';
import type { BaseLayoutProps } from '@types';
import Footer from './Footer.astro';
import Header from './Header.astro';
import SkipLink from './SkipLink.astro';

interface Props extends BaseLayoutProps {}

const { lang, title, description = SITE.description } = Astro.props;
const currentPath = Astro.url.pathname;
const pageTitle = title.includes(SITE.name) ? title : `${title} — ${SITE.name}`;
const canonicalUrl = new URL(currentPath, SITE.url);
const frenchUrl = new URL(getLocalizedPath(currentPath, 'fr'), SITE.url);
const englishUrl = new URL(getLocalizedPath(currentPath, 'en'), SITE.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="fr" href={frenchUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={frenchUrl} />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-background font-sans text-text-body">
    <SkipLink lang={lang} />
    <Header lang={lang} currentPath={currentPath} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang}>
      <slot name="newsletter" slot="newsletter" />
    </Footer>
  </body>
</html>
