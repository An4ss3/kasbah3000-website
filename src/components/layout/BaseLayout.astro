---
import Seo from '@components/seo/Seo.astro';
import { SITE } from '@constants';
import '@styles/global.css';
import { getDirection } from '@lib/utils/i18n';
import type { BaseLayoutProps } from '@types';
import Footer from './Footer.astro';
import Header from './Header.astro';
import SkipLink from './SkipLink.astro';

interface Props extends BaseLayoutProps {}

const { lang, title, description = SITE.description } = Astro.props;
const currentPath = Astro.url.pathname;
const hasCustomSeo = Astro.slots.has('seo');
const dir = getDirection(lang);
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      hasCustomSeo ? (
        <slot name="seo" />
      ) : (
        <Seo title={title} description={description} lang={lang} />
      )
    }
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-background font-sans text-text-body">
    <SkipLink lang={lang} />
    <Header lang={lang} currentPath={currentPath} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
