---
import { PRIMARY_NAV } from '@constants';
import { getLocalizedPath, t } from '@lib/utils/i18n';
import type { Language } from '@types';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileNav from './MobileNav.astro';
import Nav from './Nav.astro';
import NavCta from './NavCta.astro';

interface Props {
  lang: Language;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
---

{
  /*
  Two-tier masthead.

  The previous single row split PRIMARY_NAV around a centred logo. With eight items plus the
  CTA and the language switcher that row had no slack: the logo was wedged between two nav
  groups, German "Über uns" wrapped onto a second line and collided with it, and Arabic left a
  wide gap between the logo and the right-hand group. Splitting identity/utility (row one)
  from primary navigation (row two) gives the logo deliberate clear space, lets the nav use the
  full container width, and separates the CTA from the primary links. Both rows are
  direction-agnostic: `justify-between` and logical spacing mirror for Arabic automatically.
*/
}
<header class="sticky top-0 z-nav border-b border-border bg-background/94">
  <div class="mx-auto max-w-wide px-5 md:px-8 lg:px-12">
    {/* Compact viewports keep the single row: logo, language switcher, drawer trigger. */}
    <div class="flex h-16 items-center justify-between gap-4 md:h-18 lg:hidden">
      <a
        href={getLocalizedPath('/', lang)}
        class="inline-flex min-h-11 min-w-11 items-center"
        aria-label={`${t(lang, 'navigation.home')} — Kasbah3000`}
      >
        <img
          src="/brand/logo.png"
          width="907"
          height="768"
          alt="Kasbah3000"
          class="h-11 w-auto object-contain md:h-12"
        />
      </a>

      <div class="flex items-center gap-4">
        <LanguageSwitcher lang={lang} currentPath={currentPath} compact />
        <MobileNav lang={lang} currentPath={currentPath} />
      </div>
    </div>

    <div class="hidden lg:block">
      {/* Row one — identity and utilities. */}
      <div class="flex h-16 items-center justify-between gap-12">
        <a
          href={getLocalizedPath('/', lang)}
          class="inline-flex min-h-11 items-center"
          aria-label={`${t(lang, 'navigation.home')} — Kasbah3000`}
        >
          <img
            src="/brand/logo.png"
            width="907"
            height="768"
            alt="Kasbah3000"
            class="h-12 w-auto object-contain"
          />
        </a>

        <div class="flex items-center gap-6">
          <NavCta lang={lang} currentPath={currentPath} />
          <span class="h-5 w-px bg-border" aria-hidden="true"></span>
          <LanguageSwitcher lang={lang} currentPath={currentPath} compact />
        </div>
      </div>

      {/* Row two — primary navigation with the full container width to breathe. */}
      <div class="flex h-12 items-center border-t border-border">
        <Nav
          lang={lang}
          currentPath={currentPath}
          items={PRIMARY_NAV}
          ariaLabel={t(lang, 'navigation.primaryLabel')}
        />
      </div>
    </div>
  </div>
</header>
