---
import { PRIMARY_NAV } from '@constants';
import { getLocalizedPath, t } from '@lib/utils/i18n';
import type { Language } from '@types';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileNav from './MobileNav.astro';
import Nav from './Nav.astro';

interface Props {
  lang: Language;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const midpoint = Math.ceil(PRIMARY_NAV.length / 2);
const leftNavigation = PRIMARY_NAV.slice(0, midpoint);
const rightNavigation = PRIMARY_NAV.slice(midpoint);
---

<header class="sticky top-0 z-nav h-16 border-b border-border bg-background/94 md:h-18 lg:h-[84px]">
  <div
    class="mx-auto grid h-full max-w-wide grid-cols-[1fr_auto] items-center px-5 md:px-8 lg:grid-cols-[1fr_auto_1fr] lg:px-12"
  >
    <div class="hidden lg:block">
      <Nav
        lang={lang}
        currentPath={currentPath}
        items={leftNavigation}
        ariaLabel={t(lang, 'navigation.primaryLabel')}
      />
    </div>

    <a
      href={getLocalizedPath('/', lang)}
      class="inline-flex h-full min-w-11 items-center justify-self-start py-2 lg:justify-self-center"
      aria-label={`${t(lang, 'navigation.home')} — Kasbah3000`}
    >
      <img
        src="/brand/logo.jpeg"
        width="907"
        height="768"
        alt="Kasbah3000"
        class="h-12 w-auto object-contain md:h-14 lg:h-16"
      />
    </a>

    <div class="hidden items-center justify-end gap-6 lg:flex">
      <Nav
        lang={lang}
        currentPath={currentPath}
        items={rightNavigation}
        ariaLabel={t(lang, 'navigation.primaryLabel')}
      />
      <LanguageSwitcher lang={lang} currentPath={currentPath} compact />
    </div>

    <div class="flex items-center justify-end gap-4 lg:hidden">
      <LanguageSwitcher lang={lang} currentPath={currentPath} compact />
      <MobileNav lang={lang} currentPath={currentPath} />
    </div>
  </div>
</header>
