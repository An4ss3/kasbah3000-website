---
import { SITE } from '@constants';
import { getLocalizedPath, t } from '@lib/utils/i18n';
import type { Language } from '@types';

interface Props {
  lang: Language;
  currentPath: string;
  compact?: boolean;
}

const { lang, currentPath, compact = false } = Astro.props;
---

<nav aria-label={t(lang, 'language.label')}>
  <ul class="flex items-center gap-1" role="list">
    {
      SITE.languages.map((language, index) => (
        <li class="flex items-center">
          {index > 0 && (
            <span class="px-1 text-border-strong" aria-hidden="true">
              /
            </span>
          )}
          <a
            href={getLocalizedPath(currentPath, language)}
            lang={language}
            hreflang={language}
            aria-current={lang === language ? 'page' : undefined}
            class:list={[
              'flex min-h-11 items-center font-sans text-nav uppercase tracking-label transition-colors duration-fast hover:text-link',
              lang === language ? 'text-link' : 'text-muted',
            ]}
          >
            {compact ? language.toUpperCase() : t(lang, `language.${language}`)}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
