---
/**
 * Monochrome social brand marks.
 *
 * These are the recognisable filled silhouettes used by each service rather than generic framed
 * approximations. They inherit `currentColor`, add no icon dependency, and remain decorative: the
 * wrapping link in Footer/About owns the accessible name.
 */
export type SocialNetwork = 'linkedin' | 'youtube' | 'instagram';

interface Props {
  network: SocialNetwork;
  class?: string;
}

const { network, class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width="22"
  height="22"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  class:list={['shrink-0', className]}
>
  {
    network === 'linkedin' && (
      <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM3.56 9h3.56v11.45H3.56V9Z" />
    )
  }

  {
    network === 'youtube' && (
      <path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19 31.2 31.2 0 0 0 0 12a31.2 31.2 0 0 0 .5 5.81 3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14A31.2 31.2 0 0 0 24 12a31.2 31.2 0 0 0-.5-5.81ZM9.55 15.57V8.43L15.82 12l-6.27 3.57Z" />
    )
  }

  {
    network === 'instagram' && (
      <path d="M12 2.16c3.2 0 3.58.02 4.85.08 3.25.15 4.77 1.69 4.92 4.92.06 1.26.07 1.64.07 4.84 0 3.2-.01 3.58-.07 4.85-.15 3.23-1.67 4.77-4.92 4.92-1.27.06-1.65.07-4.85.07-3.2 0-3.58-.01-4.85-.07-3.26-.15-4.77-1.69-4.92-4.92A83 83 0 0 1 2.16 12c0-3.2.02-3.58.07-4.84.15-3.24 1.68-4.77 4.92-4.92A83 83 0 0 1 12 2.16ZM12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.69.07 7.05A85 85 0 0 0 0 12c0 3.26.01 3.67.07 4.95.2 4.36 2.63 6.78 6.98 6.98A85 85 0 0 0 12 24c3.26 0 3.67-.01 4.95-.07 4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95C23.73 2.7 21.3.27 16.95.07A85 85 0 0 0 12 0Zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.41-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z" />
    )
  }
</svg>
