# Site Configuration
PUBLIC_SITE_URL=https://kasbah3000.com

# Supabase (Public - Browser Safe)
PUBLIC_SUPABASE_URL=your_supabase_project_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase (Server Only - NEVER EXPOSE)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Brevo Email (Server Only)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@kasbah3000.com
CONTACT_RECIPIENT_EMAIL=contact@kasbah3000.com
BREVO_NEWSLETTER_LIST_ID=your_brevo_list_id
BREVO_DOI_TEMPLATE_ID=your_brevo_double_opt_in_template_id
# Override with the real production confirmation destination when it is available.
BREVO_DOI_REDIRECT_URL=https://kasbah3000.com/#newsletter

# Cloudflare Turnstile
PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# MapTiler (Public - Domain Restricted)
PUBLIC_MAPTILER_KEY=your_maptiler_api_key

# Cloudflare R2
PUBLIC_R2_BASE_URL=https://your-r2-bucket.r2.cloudflarestorage.com

# Analytics
PUBLIC_ANALYTICS_SCRIPT_URL=your_analytics_script_url
PUBLIC_ANALYTICS_SITE_ID=your_site_id

# Cloudflare Pages Deploy Hook (Server Only)
CLOUDFLARE_DEPLOY_HOOK=your_deploy_hook_url
